# Docker build context excludes (repo root is the context — see Docker/docker-compose.yml).
# The Dockerfile has no COPY today, so this is primarily about not shipping gigabytes of
# build output and history to the daemon on every build. It also keeps the future
# multi-stage runtime image clean once it starts COPYing source/artifacts.

# Build outputs and caches
out/
build/
.vs/
.ccache/
**/.venv/

# Version control and CI metadata
.git/
.github/

# Large data — model weights and datasets are converted offline and bind-mounted, never baked in
Data/Models/
Data/Datasets/
*.bin

# Editor / tooling / OS noise
.devcontainer/
.claude/
