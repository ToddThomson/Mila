# === Model: a name in the local Mila store, shared with the chat harness.
# Install it before starting the server -- MIS never downloads. List what is
# installed with the chat harness (/model list) or Mila/Samples/QuickStart/Python/store.py.
MILA_MODEL=gemma-4-12b-it-fp4

# === Protocol: mila | openai | anthropic
MILA_PROTOCOL=anthropic

# === Server ===
MILA_LOG_LEVEL=info

# === Model parameters ===
# auto: the longest context the GPU can hold, logged at startup and reported as
# context_window by /v1/models. Claude Code's harness prompt alone is ~36K Gemma
# tokens, so a fixed value below that refuses every Claude Code request.
MILA_CONTEXT_LENGTH=auto

# === Generation parameters ===
MILA_DEFAULT_MAX_NEW_TOKENS=2048
MILA_DEFAULT_TEMPERATURE=1.0
MILA_DEFAULT_TOP_K=64
MILA_DEFAULT_TOP_P=0.95
