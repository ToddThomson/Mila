# === Paths (required)
MILA_MODEL_PATH=C:\Users\ToddT\Src\Repos\Mila\Data\Models\Gemma\gemma4_12b_it_bf16.bin
MILA_TOKENIZER_PATH=C:\Users\ToddT\Src\Repos\Mila\Data\Models\Gemma\gemma_tokenizer.bin

# === Model family: gemma (Gemma 4 12B, FP4) | llama (Llama 3.x, BF16)
MILA_MODEL_FAMILY=gemma

# === Protocol: mila | openai | anthropic
MILA_PROTOCOL=anthropic

# === Server ===
MILA_LOG_LEVEL=info

# Model parameters
# Walking context up empirically on the 12 GB 4070. Measured footprint (used / free MiB):
#   4096  -> 10037 / 1974  (clean generation validated)
#   8192  -> 10352 / 1659  (+315 MiB for +4096 tokens = ~79 KiB/token)
#   16384 -> predicted ~10982 / ~1300  (Codex's floor -- testing steady-state + prefill peak)
# Only the 8 global layers keep full-context KV (40 local layers ring-bounded at the
# 1024 window), so context is cheap: growth is ~79 KiB/token.
#
# VALIDATED 2026-07-07: Claude Code's full harness prompt tokenizes to 35,719 Gemma
# tokens (system + entire built-in tool set), which 16384 rejected. 40960 works: a
# real Claude Code turn (35.7K-token prefill) runs end-to-end at 11,192 / 12,282 MiB
# used (~1.09 GB free), no OOM, no WDDM paging. NOTE: the linear ~79 KiB/token model
# above massively OVER-predicts at scale -- it forecast ~12.9 GB at 40960 but actual
# is ~11.2 GB (16384->40960 added almost nothing). The 8 global layers' KV is far
# cheaper than that extrapolation; treat the table as a loose lower bound, not linear.
MILA_CONTEXT_LENGTH=49152

# === Generation parameters ===
MILA_DEFAULT_MAX_NEW_TOKENS=2048
MILA_DEFAULT_TEMPERATURE=1.0
MILA_DEFAULT_TOP_K=64
MILA_DEFAULT_TOP_P=0.95
